    {
      "title": "Profil Kurir",
      "description": "Data diri dan profil pekerjaan Anda",
      "questions": [
        {"title": "Nama lengkap", "type": "TEXT", "required": true},
        {"title": "Usia", "type": "MULTIPLE_CHOICE", "options": ["< 20 tahun", "20-30 tahun", "31-40 tahun", "41-50 tahun", "> 50 tahun"], "required": true},
        {"title": "Domisili (Kecamatan / Kota)", "type": "TEXT", "required": true},
        {"title": "Jenis kendaraan yang dimiliki", "type": "MULTIPLE_CHOICE", "options": ["Sepeda motor", "Mobil", "Sepeda", "Lainnya"], "required": true},
        {"title": "Kapasitas muatan maksimal kendaraan", "type": "MULTIPLE_CHOICE", "options": ["< 10 kg", "10-25 kg", "25-50 kg", "> 50 kg"], "required": true},
        {"title": "Lama bekerja sebagai kurir (tahun)", "type": "MULTIPLE_CHOICE", "options": ["< 1 tahun", "1-3 tahun", "3-5 tahun", "> 5 tahun"], "required": true},
        {"title": "Platform kurir yang pernah / sedang digunakan", "type": "MULTIPLE_CHOICE", "options": ["Gojek", "Grab", "Shopee Express", "Mandiri (cari sendiri)", "Lainnya"], "required": true},
        {"title": "Rata-rata penghasilan per hari", "type": "MULTIPLE_CHOICE", "options": ["< Rp50rb", "Rp50-100rb", "Rp100-200rb", "Rp200-500rb", "> Rp500rb"], "required": true},
        {"title": "Rata-rata pengiriman per hari", "type": "MULTIPLE_CHOICE", "options": ["< 5", "5-10", "10-20", "> 20"], "required": true},
        {"title": "Jam kerja per hari", "type": "MULTIPLE_CHOICE", "options": ["< 4 jam", "4-8 jam", "8-12 jam", "> 12 jam"], "required": true}
      ]
    },
    {
