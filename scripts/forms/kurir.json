        {"title": "Bagaimana Anda mendapatkan order pengiriman?", "type": "MULTIPLE_CHOICE", "options": ["Aplikasi (Gojek/Grab)", "Langganan tetap", "Pesan langsung WA", "Datang ke pasar / toko"], "required": true},
