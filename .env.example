# ============================================================
# SEMBAKO-CHAIN AI / HARVEST — Environment Variables (TEMPLATE)
# ============================================================
# Salin ke .env:  cp .env.example .env
# Lalu sesuaikan nilainya.
# ============================================================

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/sembako_chain_ai?schema=public"
DB_PORT=5433

# ---- Aplikasi ----
# DEVELOPMENT: http://localhost:3300 (atau 3000)
# SERVER:       https://domain-anda.com
APP_URL=http://localhost:3300
APP_PORT=3300

# ---- NextAuth ----
# DEVELOPMENT: http://localhost:3300 (atau 3000)
# SERVER:       https://domain-anda.com
NEXTAUTH_URL=http://localhost:3300
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=ganti-dengan-random-string-minimal-32-karakter

# ---- API ----
# DEVELOPMENT: http://localhost:3300/api
# SERVER:       https://domain-anda.com/api
NEXT_PUBLIC_API_URL=/api

# ---- Seed Database ----
# Set ke false setelah pertama kali berhasil
SEED_DB=true

# ---- Vercel Cron Secret ----
CRON_SECRET="your-cron-secret-key"

# ---- Payment Gateway (Xendit) ----
XENDIT_SECRET_KEY="xnd_development_..."

# ---- AI/ML Service (Opsional) ----
# AI_SERVICE_URL="http://localhost:8000"

# ---- Cloud Storage (Opsional - Cloudinary) ----
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ---- Maps (Opsional) ----
# NEXT_PUBLIC_MAPBOX_TOKEN=""
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
