# ==========================================
# SEMBAKO-CHAIN AI - Environment Variables Example
# ==========================================

# ---- Database ----
# Ganti dengan connection string database PostgreSQL Anda (Neon / Supabase / Railway / VPS)
DATABASE_URL="postgresql://user:password@localhost:5432/sembako_chain_ai?schema=public"

# ---- NextAuth ----
# Di production ganti dengan URL domain Anda (contoh: https://sembakochain.com)
NEXTAUTH_URL="http://localhost:3000"
# Buat string acak 32 karakter via openssl: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-here"

# ---- API ----
# Gunakan path relatif /api agar otomatis mengikuti domain tempat website diakses
NEXT_PUBLIC_API_URL="/api"

# ---- Vercel Cron Secret ----
CRON_SECRET="your-cron-secret-key"

# ---- Payment Gateway (Xendit) ----
XENDIT_SECRET_KEY="xnd_development_..."

# ---- AI/ML Service (Opsional) ----
# AI_SERVICE_URL="http://localhost:8000"

# ---- Cloud Storage (Opsional - Cloudinary) ----
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ---- Maps (Opsional) ----
# NEXT_PUBLIC_MAPBOX_TOKEN=""
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
